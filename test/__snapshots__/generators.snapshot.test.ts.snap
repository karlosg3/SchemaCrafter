"-- Generated DDL Schema for SaaS Workspace & Subscriptions (POSTGRESQL)

CREATE SCHEMA IF NOT EXISTS "core";
CREATE SCHEMA IF NOT EXISTS "billing";

-- Enum Types Definitions
CREATE TYPE plantier AS ENUM ('free', 'pro', 'enterprise');

CREATE TABLE "core"."users" (
  "id" UUID PRIMARY KEY,
  "email" VARCHAR(255) NOT NULL UNIQUE,
  "avatar_url" VARCHAR(255)
);

CREATE TABLE "core"."organizations" (
  "id" UUID PRIMARY KEY,
  "name" VARCHAR(255) NOT NULL,
  "slug" VARCHAR(255) NOT NULL UNIQUE
);

CREATE TABLE "billing"."subscriptions" (
  "id" UUID PRIMARY KEY,
  "org_id" UUID NOT NULL,
  "stripe_customer_id" VARCHAR(255) UNIQUE,
  "plan_tier" plantier NOT NULL DEFAULT 'pro',
  "is_active" BOOLEAN NOT NULL DEFAULT true,
  CONSTRAINT "fk_subscriptions_org_id" FOREIGN KEY ("org_id") REFERENCES "core"."organizations" ("id") ON DELETE CASCADE
);"
`;

