exports[`generateCodeForTarget > ecommerce > matches the drizzle snapshot 1`] = `
"import { pgTable, pgEnum, index } from 'drizzle-orm/pg-core';

export const orderstatusEnum = pgEnum('orderstatus', ['pending', 'processing', 'shipped', 'delivered', 'cancelled']);

export const users = pgTable('users', {
  id: uuid('id').primaryKey().default('gen_random_uuid()'),
  email: varchar('email', { length: 255 }).notNull().unique(),
  password_hash: varchar('password_hash', { length: 255 }).notNull(),
  full_name: varchar('full_name', { length: 255 }),
  is_active: boolean('is_active').notNull().default('true'),
  created_at: timestamp('created_at').notNull().defaultNow(),
});

export const categories = pgTable('categories', {
  id: integer('id').primaryKey(),
  name: varchar('name', { length: 255 }).notNull().unique(),
  slug: varchar('slug', { length: 255 }).notNull().unique(),
  description: text('description'),
});

export const products = pgTable('products', {
  id: uuid('id').primaryKey(),
  title: varchar('title', { length: 255 }).notNull(),
  price: decimal('price', { precision: 10, scale: 2 }).notNull(),
  stock_quantity: integer('stock_quantity').notNull().default('0'),
  category_id: integer('category_id'),
  created_at: timestamp('created_at').notNull().defaultNow(),
});

export const orders = pgTable('orders', {
  id: uuid('id').primaryKey(),
  user_id: uuid('user_id').notNull(),
  total_amount: decimal('total_amount', { precision: 10, scale: 2 }).notNull(),
  status: orderstatusEnum('status').notNull().default('pending'),
  created_at: timestamp('created_at').notNull().defaultNow(),
});

export const orderItems = pgTable('order_items', {
  id: integer('id').primaryKey(),
  order_id: uuid('order_id').notNull(),
  product_id: uuid('product_id').notNull(),
  quantity: integer('quantity').notNull().default('1'),
  unit_price: decimal('unit_price', { precision: 10, scale: 2 }).notNull(),
});"
`;

exports[`generateCodeForTarget > ecommerce > matches the mikroorm snapshot 1`] = `
"import { Entity, PrimaryKey, Property, ManyToOne, Enum } from '@mikro-orm/core';

export enum OrderStatus {
  PENDING = 'pending',
  PROCESSING = 'processing',
  SHIPPED = 'shipped',
  DELIVERED = 'delivered',
  CANCELLED = 'cancelled',
}

@Entity({ schema: 'auth', tableName: 'users' })
export class Users {
  @PrimaryKey({ type: 'uuid' })
  id!: string;

  @Property({ unique: true })
  email!: string;

  @Property()
  password_hash!: string;

  @Property({ nullable: true })
  full_name?: string;

  @Property({ default: 'true' })
  is_active!: boolean;

  @Property({ default: 'NOW()', columnType: 'timestamptz' })
  created_at!: Date;

}

@Entity({ schema: 'catalog', tableName: 'categories' })
export class Categories {
  @PrimaryKey()
  id!: number;

  @Property({ unique: true })
  name!: string;

  @Property({ unique: true })
  slug!: string;

  @Property({ nullable: true })
  description?: string;

}

@Entity({ schema: 'catalog', tableName: 'products' })
export class Products {
  @PrimaryKey({ type: 'uuid' })
  id!: string;

  @Property()
  title!: string;

  @Property()
  price!: number;

  @Property({ default: '0' })
  stock_quantity!: number;

  @ManyToOne(() => Categories, { nullable: true, onDelete: 'set null' })
  category?: Categories;

  @Property({ default: 'NOW()', columnType: 'timestamptz' })
  created_at!: Date;

}

@Entity({ schema: 'sales', tableName: 'orders' })
export class Orders {
  @PrimaryKey({ type: 'uuid' })
  id!: string;

  @ManyToOne(() => Users, { onDelete: 'cascade' })
  user!: Users;

  @Property()
  total_amount!: number;

  @Enum({ items: () => OrderStatus, default: OrderStatus.PENDING })
  status: OrderStatus = OrderStatus.PENDING;

  @Property({ default: 'NOW()', columnType: 'timestamptz' })
  created_at!: Date;

}

@Entity({ schema: 'sales', tableName: 'order_items' })
export class OrderItems {
  @PrimaryKey()
  id!: number;

  @ManyToOne(() => Orders, { onDelete: 'cascade' })
  order!: Orders;

  @ManyToOne(() => Products, { onDelete: 'restrict' })
  product!: Products;

  @Property({ default: '1' })
  quantity!: number;

  @Property()
  unit_price!: number;

}"
`;

exports[`generateCodeForTarget > ecommerce > matches the prisma snapshot 1`] = `
"datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

model Users {
  id String @id @default(uuid())
  email String @unique
  password_hash String
  full_name String?
  is_active Boolean @default(true)
  created_at DateTime @default(now())
}

model Categories {
  id Int @id
  name String @unique
  slug String @unique
  description String?
}

model Products {
  id String @id
  title String
  price Decimal
  stock_quantity Int @default(0)
  category_id Int?
  category Categories @relation(fields: [category_id], references: [id])
  created_at DateTime @default(now())
}

model Orders {
  id String @id
  user_id String
  user Users @relation(fields: [user_id], references: [id])
  total_amount Decimal
  status OrderStatus @default(pending)
  created_at DateTime @default(now())
}

model OrderItems {
  id Int @id
  order_id String
  order Orders @relation(fields: [order_id], references: [id])
  product_id String
  product Products @relation(fields: [product_id], references: [id])
  quantity Int @default(1)
  unit_price Decimal
}"
`;

exports[`generateCodeForTarget > ecommerce > matches the sql snapshot 1`] = `
"-- Generated DDL Schema for E-Commerce Platform (POSTGRESQL)

CREATE SCHEMA IF NOT EXISTS "auth";
CREATE SCHEMA IF NOT EXISTS "catalog";
CREATE SCHEMA IF NOT EXISTS "sales";

-- Enum Types Definitions
CREATE TYPE orderstatus AS ENUM ('pending', 'processing', 'shipped', 'delivered', 'cancelled');

CREATE TABLE "auth"."users" (
  "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  "email" VARCHAR(255) NOT NULL UNIQUE,
  "password_hash" VARCHAR(255) NOT NULL,
  "full_name" VARCHAR(255),
  "is_active" BOOLEAN NOT NULL DEFAULT true,
  "created_at" TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE "catalog"."categories" (
  "id" SERIAL PRIMARY KEY,
  "name" VARCHAR(255) NOT NULL UNIQUE,
  "slug" VARCHAR(255) NOT NULL UNIQUE,
  "description" TEXT
);

CREATE TABLE "catalog"."products" (
  "id" UUID PRIMARY KEY,
  "title" VARCHAR(255) NOT NULL,
  "price" NUMERIC(10, 2) NOT NULL,
  "stock_quantity" INTEGER NOT NULL DEFAULT 0,
  "category_id" INTEGER,
  "created_at" TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT "fk_products_category_id" FOREIGN KEY ("category_id") REFERENCES "catalog"."categories" ("id") ON DELETE SET NULL
);

CREATE TABLE "sales"."orders" (
  "id" UUID PRIMARY KEY,
  "user_id" UUID NOT NULL,
  "total_amount" NUMERIC(10, 2) NOT NULL,
  "status" orderstatus NOT NULL DEFAULT 'pending',
  "created_at" TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT "fk_orders_user_id" FOREIGN KEY ("user_id") REFERENCES "auth"."users" ("id") ON DELETE CASCADE
);

CREATE TABLE "sales"."order_items" (
  "id" SERIAL PRIMARY KEY,
  "order_id" UUID NOT NULL,
  "product_id" UUID NOT NULL,
  "quantity" INTEGER NOT NULL DEFAULT 1,
  "unit_price" NUMERIC(10, 2) NOT NULL,
  CONSTRAINT "fk_order_items_order_id" FOREIGN KEY ("order_id") REFERENCES "sales"."orders" ("id") ON DELETE CASCADE,
  CONSTRAINT "fk_order_items_product_id" FOREIGN KEY ("product_id") REFERENCES "catalog"."products" ("id") ON DELETE RESTRICT
);"
`;

exports[`generateCodeForTarget > ecommerce > matches the typeorm snapshot 1`] = `
"import { Entity, PrimaryGeneratedColumn, Column, ManyToOne, JoinColumn } from 'typeorm';

export enum OrderStatus {
  PENDING = 'pending',
  PROCESSING = 'processing',
  SHIPPED = 'shipped',
  DELIVERED = 'delivered',
  CANCELLED = 'cancelled',
}

@Entity({ schema: 'auth', name: 'users' })
export class Users {
  @PrimaryGeneratedColumn('uuid')
  id!: string;

  @Column({ unique: true })
  email!: string;

  @Column()
  password_hash!: string;

  @Column({ nullable: true })
  full_name?: string;

  @Column({ default: 'true' })
  is_active!: boolean;

  @Column({ default: 'NOW()' })
  created_at!: Date;

}

@Entity({ schema: 'catalog', name: 'categories' })
export class Categories {
  @PrimaryGeneratedColumn()
  id!: number;

  @Column({ unique: true })
  name!: string;

  @Column({ unique: true })
  slug!: string;

  @Column({ nullable: true })
  description?: string;

}

@Entity({ schema: 'catalog', name: 'products' })
export class Products {
  @PrimaryGeneratedColumn('uuid')
  id!: string;

  @Column()
  title!: string;

  @Column()
  price!: number;

  @Column({ default: '0' })
  stock_quantity!: number;

  @ManyToOne(() => Categories)
  @JoinColumn({ name: 'category_id' })
  category?: Categories;

  @Column({ default: 'NOW()' })
  created_at!: Date;

}

@Entity({ schema: 'sales', name: 'orders' })
export class Orders {
  @PrimaryGeneratedColumn('uuid')
  id!: string;

  @ManyToOne(() => Users)
  @JoinColumn({ name: 'user_id' })
  user!: Users;

  @Column()
  total_amount!: number;

  @Column({ type: 'enum', enum: OrderStatus, default: OrderStatus.PENDING })
  status: OrderStatus;

  @Column({ default: 'NOW()' })
  created_at!: Date;

}

@Entity({ schema: 'sales', name: 'order_items' })
export class OrderItems {
  @PrimaryGeneratedColumn()
  id!: number;

  @ManyToOne(() => Orders)
  @JoinColumn({ name: 'order_id' })
  order!: Orders;

  @ManyToOne(() => Products)
  @JoinColumn({ name: 'product_id' })
  product!: Products;

  @Column({ default: '1' })
  quantity!: number;

  @Column()
  unit_price!: number;

}"
`;

