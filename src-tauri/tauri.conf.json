{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SchemaCrafter",
  "version": "0.1.0",
  "identifier": "com.karlosg3.schemacrafter",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "title": "SchemaCrafter",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost tauri: https://tauri.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Visual database schema designer",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["schemacrafter"],
        "mimeType": "application/x-schemacrafter",
        "name": "SchemaCrafter Project",
        "description": "SchemaCrafter database workspace file",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.karlosg3.schemacrafter.project",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/schemacrafter.xml": "linux/schemacrafter-mime.xml",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-schemacrafter.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-schemacrafter.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-schemacrafter.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-schemacrafter.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-schemacrafter.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-schemacrafter.svg": "icons/schemacrafter-blueprint.svg",
          "/usr/share/icons/hicolor/scalable/apps/schemacrafter.svg": "icons/schemacrafter-blueprint.svg"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
